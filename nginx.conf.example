# Nginx 配置示例
# 将此配置添加到你的 Nginx 站点配置文件中
# 通常位于 /etc/nginx/sites-available/ 或 /etc/nginx/conf.d/

server {
    listen 80;
    server_name lkr2312.j3.ink;  # 替换为你的域名

    root /var/www/anime-wallpaper-site;  # 替换为你的网站目录
    index index.html;

    # 字体文件 MIME 类型
    types {
        font/ttf ttf;
        font/woff woff;
        font/woff2 woff2;
    }

    # 静态资源缓存
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|ttf|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA 路由支持 - 所有路径都返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 确保字体文件可访问
    location /fonts/ {
        alias /var/www/anime-wallpaper-site/fonts/;
        add_header Access-Control-Allow-Origin *;
    }
}
